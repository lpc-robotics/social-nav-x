<?xml version="1.0"?>
<package format="3">
  <name>arena_peer_costmap</name>
  <version>0.1.0</version>
  <description>Ideal peer-robot occupancy layer for the Arena5 multi-robot baseline.</description>
  <maintainer email="lpc-robotics@users.noreply.github.com">lpc-robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/peer_costmap_plugins.xml" />
  </export>
</package>
