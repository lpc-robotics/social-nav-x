index 0000000..c68bfa9
--- /dev/null
+++ b/arena_isaac/test/test_scan_geometry.py
@@ -0,0 +1,124 @@
+import math
+
+import numpy as np
+
+from isaac_utils.scan_geometry import (
+    adapt_scan_for_control,
+    camera_sample_map,
+    depth_views_to_ranges,
+    normalized_scan_layout,
+)
+
+
+def test_full_circle_layout_does_not_duplicate_endpoint():
+    layout = normalized_scan_layout(640, -math.pi, math.pi)
+    assert len(layout.angles) == 640
+    assert layout.angle_max < math.pi
+    assert math.isclose(layout.angle_increment, 2.0 * math.pi / 640)
+    assert not math.isclose(layout.angles[0], layout.angles[-1])
+
+
+def test_rounded_urdf_full_circle_uses_exact_two_pi_increment():
+    layout = normalized_scan_layout(640, -3.14159, 3.14159)
+    assert math.isclose(layout.angle_increment, 2.0 * math.pi / 640)
+    assert math.isclose(layout.angle_max, -3.14159 + 639.0 * 2.0 * math.pi / 640)
+
+
+def test_partial_layout_includes_both_declared_endpoints():
+    layout = normalized_scan_layout(5, -1.0, 1.0)
+    np.testing.assert_allclose(layout.angles, [-1.0, -0.5, 0.0, 0.5, 1.0])
+    assert layout.angle_max == 1.0
+
+
+def test_camera_map_covers_quadrants_with_small_nearest_ray_error():
+    angles = normalized_scan_layout(640, -math.pi, math.pi).angles
+    views, pixels, sampled = camera_sample_map(angles, 1025)
+    assert set(views.tolist()) == {0, 1, 2, 3}
+    assert pixels.min() >= 0
+    assert pixels.max() < 1025
+    error = np.abs((sampled - angles + math.pi) % (2.0 * math.pi) - math.pi)
+    assert error.max() < 0.001
+
+
+def test_rep117_conversion_keeps_all_four_states_distinct():
+    rows = np.full((4, 9), np.nan)
+    rows[0] = [-1.0, 0.0, np.nan, -np.inf, 0.03, 0.08, 2.0, np.inf, 13.0]
+    views = np.zeros(9, dtype=int)
+    pixels = np.arange(9)
+    ranges = depth_views_to_ranges(rows, views, pixels, 0.08, 12.0)
+    assert np.isnan(ranges[0])
+    assert np.isposinf(ranges[1])
+    assert np.isnan(ranges[2])
+    assert np.isnan(ranges[3])
+    assert np.isneginf(ranges[4])
+    assert ranges[5] == np.float32(0.08)
+    assert ranges[6] == np.float32(2.0)
+    assert np.isposinf(ranges[7])
+    assert np.isposinf(ranges[8])
+
+
+def test_sampling_uses_one_pixel_and_never_blends_across_a_depth_edge():
+    rows = np.full((4, 1025), 12.0)
+    rows[0, 511] = 1.0
+    rows[0, 512] = 9.0
+    rows[0, 513] = 2.0
+    angles = np.array([0.001, 0.0, -0.001])
+    views, pixels, _ = camera_sample_map(angles, 1025)
+    ranges = depth_views_to_ranges(rows, views, pixels, 0.08, 12.0)
+    assert set(ranges.tolist()).issubset({1.0, 2.0, 9.0, 12.0})
+
+
+def test_configured_noise_is_repeatable_and_quantized():
+    rows = np.full((4, 8), 2.0)
+    views = np.zeros(8, dtype=int)
+    pixels = np.arange(8)
+    one = depth_views_to_ranges(
+        rows, views, pixels, 0.08, 12.0,
+        noise_mean=0.02, noise_stddev=0.01,
+        range_resolution=0.01, rng=np.random.default_rng(42),
+    )
+    two = depth_views_to_ranges(
+        rows, views, pixels, 0.08, 12.0,
+        noise_mean=0.02, noise_stddev=0.01,
+        range_resolution=0.01, rng=np.random.default_rng(42),
+    )
+    np.testing.assert_array_equal(one, two)
+    np.testing.assert_allclose(one / 0.01, np.round(one / 0.01), atol=2e-5)
+
+
+def test_noise_mean_applies_only_to_finite_hits():
+    rows = [
+        np.array([2.0, np.inf, 0.04, np.nan]),
+        np.ones(4),
+        np.ones(4),
+        np.ones(4),
+    ]
+    ranges = depth_views_to_ranges(
+        rows,
+        np.zeros(4, dtype=np.int64),
+        np.arange(4),
+        0.08,
+        12.0,
+        noise_mean=0.03,
+    )
+
+    np.testing.assert_allclose(ranges[0], 2.03)
+    assert np.isposinf(ranges[1])
+    assert np.isneginf(ranges[2])
+    assert np.isnan(ranges[3])
+
+
+def test_control_adapter_is_conservative_and_preserves_masks():
+    scan = np.array([1.0, np.inf, -np.inf, np.nan, -1.0, 13.0], dtype=np.float32)
+    observation = adapt_scan_for_control(scan, 0.08, 12.0)
+    np.testing.assert_array_equal(observation.ranges, [1.0, 12.0, 0.0, 0.0, 0.0, 0.0])
+    np.testing.assert_array_equal(observation.hit, [1, 0, 0, 0, 0, 0])
+    np.testing.assert_array_equal(observation.no_return, [0, 1, 0, 0, 0, 0])
+    np.testing.assert_array_equal(observation.too_close, [0, 0, 1, 0, 0, 0])
+    np.testing.assert_array_equal(observation.unknown, [0, 0, 0, 1, 1, 1])
+    np.testing.assert_array_equal(observation.usable_ray, [1, 1, 0, 0, 0, 0])
+
+
+def test_control_adapter_rejects_non_finite_fill():
+    with np.testing.assert_raises(ValueError):
+        adapt_scan_for_control([1.0], 0.08, 12.0, unknown_fill=np.nan)
