<?xml version="1.0"?>
<package format="3">
  <name>formal_social_behavior</name>
  <version>0.1.0</version>
  <description>Deterministic social-state automata and HuNav v1 reset proxy for Arena Isaac.</description>
  <maintainer email="noreply@example.com">social-nav-x maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>hunav_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>arena_humble_compat</exec_depend>
  <exec_depend>arena_isaac</exec_depend>
  <exec_depend>arena_simulation_setup</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>hunav_agent_manager</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
