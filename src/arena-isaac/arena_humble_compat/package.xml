<?xml version="1.0"?>
<package format="3">
  <name>arena_humble_compat</name>
  <version>0.0.0</version>
  <description>Small ROS 2 Humble adapter for Arena Isaac 5.1 services and Jackal commands.</description>
  <maintainer email="noreply@example.com">Arena local deployment</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>hunav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>isaacsim_msgs</depend>
  <depend>arena_people_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
